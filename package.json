{
  "name": "cattus-study-verify",
  "version": "0.1.0",
  "description": "On-device study verification for React Native: checks camera frames for a hand plus a book, laptop or keyboard with a MediaPipe palm detector and an EfficientDet-Lite0 object detector. No server.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "jest",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "vision-camera",
    "tflite",
    "mediapipe",
    "on-device",
    "study",
    "focus"
  ],
  "repository": "https://github.com/OneOrThree/cattus-study-verify",
  "bugs": {
    "url": "https://github.com/OneOrThree/cattus-study-verify/issues"
  },
  "author": "OneOrThree (https://github.com/OneOrThree)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OneOrThree/cattus-study-verify#readme",
  "dependencies": {},
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-resizer": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.32",
    "jest": "^29.7.0",
    "jest-expo": "57.0.2",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-resizer": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "files": [
    "build",
    "src",
    "assets",
    "NOTICE"
  ]
}
