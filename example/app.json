{
  "expo": {
    "name": "CattusStudyVerify Example",
    "slug": "cattus-study-verify-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneorthree.cattus.studyverify.example",
      "infoPlist": {
        "NSCameraUsageDescription": "The example checks camera frames on this device to find a hand and a study object. Nothing is saved or sent."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oneorthree.cattus.studyverify.example",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
